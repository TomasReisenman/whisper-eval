y un panel de gráficos de barras.","metadata":{}},{"cell_type":"code","source":"J_FIELDS = [\"grammar_score\", \"spelling_score\", \"intent_score\", \"slots_score\", \"language_identification\"]\njrows = []\nfor sp, d in dfm.items():\n    for recs in d[\"judgments\"].map(as_records):\n        for r in recs:\n            jrows.append({\"split\": sp, **{k: r.get(k) for k in J_FIELDS}})\njdf = pd.DataFrame(jrows)\nprint(f\"juicios totales: {len(jdf)} (promedio por frase: {len(jdf) / sum(len(d) for d in dfm.values()):.2f})\")\n\nfig, axes = plt.subplots(2, 3, figsize=(15, 7)); axes = axes.ravel()\nfor ax, f in zip(axes, J_FIELDS):\n    vc = jdf[f].value_counts(normalize=True).sort_index()\n    display(vc.mul(100).round(1).to_frame(f\"{f} (%)\").T)\n    vc.plot(kind=\"bar\", ax=ax, title=f)\naxes[-1].axis(\"off\")\nplt.tight_layout(); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-23T21:24:25.725278Z","iopub.execute_input":"2026-11-23T21:24:25.725703Z","iopub.status.idle":"2026-11-23T21:24:26.73198Z","shell.execute_reply.started":"2026-11-23T21:24:25.725672Z","shell.execute_reply":"2026-11-23T21:24:26.731192Z"}},"outputs":[{"name":"stdout","text":"juicios totales: 49562 (promedio por frase: 3.00)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"grammar_score        0    1    2     3     4\ngrammar_score (%)  0.0  0.3  2.0  12.2  85.5","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th>grammar_score</th>\n      <th>0</th>\n      <th>1</th>\n      <th>2</th>\n      <th>3</th>\n      <th>4</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>grammar_score (%)</th>\n      <td>0.0</td>\n      <td>0.