stance(o, (np.integer,)): return int(o)\n    if isinstance(o, (np.floating,)): return float(o)\n    if isinstance(o, np.ndarray): return o.tolist()\n    return str(o)\n\nrun_log = {\n    \"fecha_inicio_utc\": START_ISO, \"fecha_fin_utc\": datetime.now(timezone.utc).isoformat(timespec=\"seconds\"),\n    \"duracion_total_s\": round(time.time() - T0_NOTEBOOK, 1),\n    \"dispositivo\": device, \"fp16\": USE_FP16, \"semilla\": SEED, \"cfg_hash\": CFG_HASH,\n    \"versiones\": LIB_VERSIONS, \"constantes\": CONFIG_SNAPSHOT,\n    \"modelos\": {\"whisper\": WHISPER_MODEL, \"bert\": BERT_MODEL, \"baseline\": \"TF-IDF (palabras + caracteres) + regresión logística + reglas/diccionario\"},\n    \"baseline\": {\"C_elegido\": base[\"best_C\"], \"extractor_precision_minima\": EXTRACTOR_MIN_PREC, \"extractor_reglas\": EXTRACTOR_USE_REGEX},\n    \"fuentes_de_datos\": DATA_SOURCES,\n    \"cruce_por_id\": CROSS_REPORT,\n    \"ejemplos_emparejados\": {sp: int(len(MATCHED[sp])) for sp in SPLITS_AUDIO},\n    \"umbrales_baja_confianza\": THR,\n    \"tiempo_whisper_s\": {k: round(v, 1) for k, v in TIMES.items()},\n    \"archivos\": {\"transcripciones\": TRANSCRIPT_CSV, \"dashboard_parquet\": DASH_PARQUET, \"dashboard_csv\": DASH_CSV},\n}\nwith open(RUN_LOG_PATH, \"w\", encoding=\"utf-8\") as f:\n    json.dump(run_log, f, ensure_ascii=False, indent=2, default=_jsonable)\nprint(\"guardado en\", RUN_LOG_PATH)\nprint(json.dumps({k: run_log[k] for k in [\"duracion_total_s\", \"dispositivo\", \"ejemplos_emparejados\", \"umbrales_baja_confianza\", \"fuentes_de_datos\"]}, ensure_ascii=False, indent=2, default=_jsonable))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-23T21:39:50.911042Z","iopub.execute_input":"2026-11-23T21:39:50.911675Z","iopub.status.idle":"2026-11-23T21:39:50.921178Z","shell.execute_reply.started":"2026-11-23T21:39:50.911653Z","shell.execute_reply":"2026-11-23T21:39:50.920414Z"}},"outputs":[{"name":"stdout","text":"guardado en /kaggle/working/run_log.json\