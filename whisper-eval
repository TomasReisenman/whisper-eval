except Exception:\n        return []\n\nsm = {}\nfor sp, d in dfm.items():\n    c = Counter(r.get(\"method\") for recs in d[\"slot_method\"].map(as_records) for r in recs)\n    sm[sp] = c\nsm_df = pd.DataFrame(sm).fillna(0).astype(int)\ndisplay(sm_df)\ndisplay((100 * sm_df / sm_df.sum()).round(1).add_suffix(\" (%)\"))\n(sm_df / sm_df.sum()).plot(kind=\"bar\", figsize=(7, 3.5), title=\"slot_method: proporción por split\")\nplt.tight_layout(); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-23T21:24:25.522452Z","iopub.execute_input":"2026-11-23T21:24:25.522805Z","iopub.status.idle":"2026-11-23T21:24:25.724369Z","shell.execute_reply.started":"2026-11-23T21:24:25.522775Z","shell.execute_reply":"2026-11-23T21:24:25.723776Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"                       train  validation  test\ntranslation             7520        1344  1865\nlocalization            2020         340   511\nunchanged               1459         262   367\nunchanged_translation      2           0     0","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>train</th>\n      <th>validation</th>\n      <th>test</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>translation</th>\n      <td>7520</td>\n      <td>1344</td>\n      <td>1865</td>\n    </tr>\n    <tr>\n      <th>localization</th>\n      <td>2020</td>\n      <td>340</td>\n      <td>511</td>\n    </tr>\n    <tr>\n      <th>unchanged</th>\n      <td>1459</td>\n      <td>262</td>\n      <td>367</td>\n    </tr>\n    <tr>\n      <th>unchanged_translation</th>\n      <td>2</td>\n      <td>0</td>\n      <td>0</td>\n    </tr>\n  </tbody>\n</