um()),\n                           \"sin slots\": int((d[\"n_slots\"] == 0).sum()),\n                           \"% sin slots\": round(100 * (d[\"n_slots\"] == 0).mean(), 1),\n                           \"slots totales\": int(d[\"n_slots\"].sum()),\n                           \"slots por frase (media)\": round(d[\"n_slots\"].mean(), 2)} for sp, d in dfm.items()}).T)\n\ntype_counts = Counter(t for sl in dfm[\"train\"][\"slots_raw\"] for t, _ in sl)\nprint(f\"Tipos de slot distintos en train: {len(type_counts)}\")\ntc = pd.Series(type_counts).sort_values(ascending=False)\n\nfig, axes = plt.subplots(1, 2, figsize=(14, 4))\nfor sp, d in dfm.items():\n    vc = d[\"n_slots\"].clip(upper=8).value_counts(normalize=True).sort_index()\n    axes[0].plot(vc.index, vc.values, marker=\"o\", label=sp)\naxes[0].set_title(\"Slots por frase (8 = 8 o más)\"); axes[0].set_xlabel(\"slots\"); axes[0].set_ylabel(\"proporción\"); axes[0].legend()\ntc.head(15)[::-1].plot(kind=\"barh\", ax=axes[1]); axes[1].set_title(\"15 tipos de slot más frecuentes (train)\")\nplt.tight_layout(); plt.show()\n\nvals_by_type = defaultdict(Counter)\nfor sl in dfm[\"train\"][\"slots_raw\"]:\n    for t, v in sl:\n        vals_by_type[t][v] += 1\ndisplay(pd.DataFrame({t: pd.Series([f\"{v} ({c})\" for v, c in vals_by_type[t].most_common(5)]) for t in tc.index[:8]}).T.rename(columns=lambda i: f\"top {i+1}\").fillna(\"\"))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-23T21:24:24.976274Z","iopub.execute_input":"2026-11-23T21:24:24.976569Z","iopub.status.idle":"2026-11-23T21:24:25.521266Z","shell.execute_reply.started":"2026-11-23T21:24:24.976549Z","shell.execute_reply":"2026-11-23T21:24:25.520412Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"             frases  con slots  sin slots  % sin slots  slots totales  slots por frase (media)\ntrain       11514.0     7639.0     3875.0         33.7        11154.0                     0.97\nvalidation   2033.0     1370.0      663.0