n    ev = [(e[\"step\"], e[\"eval_loss\"]) for e in log if \"eval_loss\" in e]\n    em = [(e[\"step\"], e[mkey]) for e in log if mkey in e]\n    if tr: axes[row, 0].plot(*zip(*tr), label=\"train\")\n    if ev: axes[row, 0].plot(*zip(*ev), marker=\"o\", label=\"dev\")\n    axes[row, 0].set_title(f\"BERT {name}: pérdida\"); axes[row, 0].set_xlabel(\"paso\"); axes[row, 0].legend()\n    if em: axes[row, 1].plot(*zip(*em), marker=\"o\", color=\"tab:green\")\n    axes[row, 1].set_title(f\"BERT {name}: {mkey.replace('eval_', '')} en dev\"); axes[row, 1].set_xlabel(\"paso\")\nplt.tight_layout(); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-23T21:36:30.561588Z","iopub.execute_input":"2026-11-23T21:36:30.562276Z","iopub.status.idle":"2026-11-23T21:36:31.0885Z","shell.execute_reply.started":"2026-11-23T21:36:30.562252Z","shell.execute_reply":"2026-11-23T21:36:31.08786Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1300x700 with 4 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":39},{"cell_type":"markdown","source":"### 6.4 Inferencia: probabilidades de intención, etiquetas de slots y pares (tipo, valor)\n\n- `bert_intent_probs`: softmax sobre las 60 intenciones; la **confianza** es el máximo, y el **escenario** se deriva de la intención predicha.\n- `bert_slot_tags`: predice una etiqueta BIO por **palabra** (se usa la primera subpalabra). Las palabras del texto son `texto.split()`, igual que en el texto de referencia, de modo que la misma función sirve para referencia y para Whisper. Si el texto es más largo que `BERT_MAX_LEN` subpalabras, las palabras que no entran quedan en `O`.\n- `tags_to_pairs`: reconstruye los pares (tipo, valor) uniendo las palabras de cada tramo. Un `I-x` sin `B-x` previo inicia un tramo. El valor se normaliza con `normalize` (la misma función que en la anotación).\n\n**Salida esperada:** una prueba rápida sobre una frase del dev (frase, intención predicha, etiquetas y pares).","metadata":{}},{"cell_type":"code","source":"@torch.no_grad()\ndef bert_intent_probs(texts, bs=None):\n    bs = bs or BERT_BATCH * 4\n    texts = [str(t) for t in texts]\n    out = []\n    for i in range(0, len(texts), bs):\n        enc = bert_tok(texts[i:i + bs], truncation=True, max_length=BERT_MAX_LEN, padding=True, return_tensors=\"pt\").to(device)\n        with torch.autocast(device_type=\"cuda\", dtype=torch.float16, enabled=USE_FP16):\n            logits = bert_int(**enc).logits\n        out.append(torch.softmax(logits.float(), dim=-1).cpu().numpy())\n    return np.concatenate(out) if out else np.zeros((0, len(intent_names)))\n\n@torch.no_grad()\ndef bert_slot_tags(texts, bs=None):\n    bs = bs or BERT_BATCH * 4\n    words_all = [str(t).split() for t in texts]\n    result = [[\"O\"] * len(w) for w in words_all]\n    idx = [i for i, w in enumerate(words_all) if w]\n    for s in range(0, len(idx), bs):\n        chunk = idx[s:s + bs]\n        enc = bert_tok([words_all[i] for i in chunk], is_split_into_words=True, truncation=True, max_length=BERT_MAX_LEN,\n                       padding=True, return_tensors=\"pt\")\n        wids = [enc.word_ids(k) for k in range(len(chunk))]\n        with torch.autocast(device_type=\"cuda\", dtype=torch.float16, enabled=USE_FP16):\n            logits = bert_slot(**enc.to(device)).logits\n        pred = logits.argmax(-1).cpu().numpy()\n        for k, i in enumerate(chunk):\n            prev = None\n            for pos, w in enumerate(wids[k]):\n                if w is not None and w != prev:\n                    result[i][w] = id2slot[int(pred[k][pos])]\n                prev = w\n    return result\n\ndef tags_to_pairs(words, tags):\n    spans, cur = [], None\n    for i, t in enumerate(tags):\n        if t == \"O\":\n            if cur: spans.append(cur); cur = None\n        else:\n            p, typ = t.split(\"-\", 1)\n            if p == \"B\" or cur is None or cur[0] != typ:\n                if cur: spans.append(cur)\n                cur = [typ, i, i]\n            else:\n                cur[2] = i\n    if cur: spans.append(cur)\n    pairs = []\n    for typ, s, e in spans:\n        v = normalize(\" \".join(words[s:e + 1]))\n        if v: pairs.append((typ, v))\n    return pairs\n\ndef predict_bert(texts):\n    texts = [str(t) for t in texts]\n    probs = bert_intent_probs(texts)\n    tags = bert_slot_tags(texts)\n    return {\"probs\": probs, \"intent_id\": probs.argmax(1), \"conf\": probs.max(1),\n            \"scenario_id\": intent_to_scenario_id[probs.argmax(1)],\n            \"pairs\": [tags_to_pairs(t.split(), tg) for t, tg in zip(texts, tags)], \"tags\": tags}\n\nPREDICTORS = {\"baseline\": predict_baseline, \"bert\": predict_bert}\n\ndemo = dev_df.iloc[0]\npb = predict_bert([demo[\"utt\"]])\nprint(\"frase:\", demo[\"utt\"]); print(\"real:\", demo[\"intent_name\"], \"|\", demo[\"pairs_gold\"])\nprint(\"BERT:\", intent_names[pb[\"intent_id\"][0]], f\"(conf {pb['conf'][0]:.2f})\", \"|\", pb[\"pairs\"][0]); print(\"etiquetas:\", pb[\"tags\"][0])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-23T21:36:31.089594Z","iopub.execute_input":"2026-11-23T21:36:31.089923Z","iopub.status.idle":"2026-11-23T21:36:31.297492Z","shell.execute_reply.started":"2026-11-23T21:36:31.08989Z","shell.execute_reply":"2026-11-23T21:36:31.296654Z"}},"outputs":[{"name":"stdout","text":"frase: apaga las luces por favor\nreal: iot_hue_lightoff | []\nBERT: iot_hue_lightoff (conf 0.87) | []\netiquetas: ['O', 'O', 'O', 'O', 'O']\n","output_type":"stream"}],"execution_count":40},{"cell_type":"markdown","source":"### 6.5 Control en dev (solo para verificar que los modelos funcionan)\n\nSe evalúan los dos modelos sobre **todo** el dev de MASSIVE (texto de referencia) con las funciones de la sección 3. Son números de **desarrollo**, no el resultado del experimento. Sirven para detectar errores obvios (por ejemplo un modelo que predice una sola clase). El F1 de seqeval se calcula solo sobre las frases con parseo alineado.\n\n**Salida esperada:** una tabla con una fila por modelo: accuracy y macro-F1 de intención y escenario, P/R/F1 de pares y F1 de seqeval.","metadata":{}},{"cell_type":"code","source":"def full_metrics(pred, df, with_seqeval):\n    out = {}\n    out.update({f\"intent_{k}\": v for k, v in clf_metrics(df[\"intent_id\"].values, pred[\"intent_id\"]).items()})\n    out.update({f\"scenario_{k}\": v for k, v in clf_metrics(df[\"scenario_id\"].values, pred[\"scenario_id\"]).items()})\n    pm = pair_metrics(list(df[\"pairs_gold\"]), pred[\"pairs\"])\n    out.update({k: pm[k] for k in [\"pair_precision\", \"pair_recall\", \"pair_f1\", \"pair_f1_type_only\"]})\n    if with_seqeval:\n        ok = np.where(df[\"parse_ok\"].values)[0]\n        out[\"seq_f1\"] = seqeval_scores([list(df[\"tags_gold\"].iloc[i]) for i in ok], [pred[\"tags\"][i] for i in ok])[\"seq_f1\"]\n        out[\"seq_n_excluidas\"] = int(len(df) - len(ok))\n    return out\n\ndev_texts = list(dev_df[\"utt\"])\ndev_check = {name: full_metrics(fn(dev_texts), dev_df, True) for name, fn in PREDICTORS.items()}\ndisplay(pd.DataFrame(dev_check).T.round(3))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-23T21:36:31.29851Z","iopub.execute_input":"2026-11-23T21:36:31.299272Z","iopub.status.idle":"2026-11-23T21:36:33.50107Z","shell.execute_reply.started":"2026-11-23T21:36:31.29924Z","shell.execute_reply":"2026-11-23T21:36:33.500416Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"          intent_accuracy  intent_macro_f1  scenario_accuracy  scenario_macro_f1  pair_precision  pair_recall  pair_f1  pair_f1_type_only  seq_f1  seq_n_excluidas\nbaseline            0.843            0.816              0.894              0.889           0.710        0.589    0.644              0.754   0.644              0.0\nbert                0.865            0.805              0.907              0.898           0.697        0.743    0.719              0.823   0.719              0.0","text/html":"<div>\n<style scoped>\n    .dataframe tbody tr th:only-of-type {\n        vertical-align: middle;\n    }\n\n    .dataframe tbody tr th {\n        vertical-align: top;\n    }\n\n    .dataframe thead th {\n        text-align: right;\n    }\n</style>\n<table border=\"1\" class=\"dataframe\">\n  <thead>\n    <tr style=\"text-align: right;\">\n      <th></th>\n      <th>intent_accuracy</th>\n      <th>intent_macro_f1</th>\n      <th>scenario_accuracy</th>\n      <th>scenario_macro_f1</th>\n      <th>pair_precision</th>\n      <th>pair_recall</th>\n      <th>pair_f1</th>\n      <th>pair_f1_type_only</th>\n      <th>seq_f1</th>\n      <th>seq_n_excluidas</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <th>baseline</th>\n      <td>0.843</td>\n      <td>0.816</td>\n      <td>0.894</td>\n      <td>0.889</td>\n      <td>0.710</td>\n      <td>0.589</td>\n      <td>0.644</td>\n      <td>0.754</td>\n      <td>0.644</td>\n      <td>0.0</td>\n    </tr>\n    <tr>\n      <th>bert</th>\n      <td>0.865</td>\n      <td>0.805</td>\n      <td>0.907</td>\n      <td>0.898</td>\n      <td>0.697</td>\n      <td>0.743</td>\n      <td>0.719</td>\n      <td>0.823</td>\n      <td>0.719</td>\n      <td>0.0</td>\n    </tr>\n  </tbody>\n</table>\n</div>"},"metadata":{}}],"execution_count":41},{"cell_type":"markdown","source":"## 7. Speech-MASSIVE y prueba piloto del cruce por `id`\n\nEl audio vive en Speech-MASSIVE; las **etiquetas correctas son siempre las de MASSIVE**. Para usar las dos fuentes hay que **cruzar por `id`** (y `locale`, ya filtrado a es-ES) y quedarse solo con las frases que existen en ambas. Ese subconjunto emparejado es el **único** que se usa en las corridas A y B.\n\n### 7.1 Carga de Speech-MASSIVE (audio a 16 kHz) y verificación del esquema\n\n- Se carga `validation` de `FBK-MT/Speech-MASSIVE` (es-ES) y, **solo si `RUN_TEST=True`**, `test` de `FBK-MT/Speech-MASSIVE-test`. El audio se declara a 16 kHz (`Audio(sampling_rate=16000)`): se decodifica y remuestrea **recién cuando se pide** una fila, no al cargar.\n- Se imprimen las **columnas reales** y se comparan con las esperadas (`id`, `utt`, `annot_utt`, `scenario_str`, `intent_str`, `speaker_*`, `is_validated`, etc.). Si faltan `id`, `utt` o `annot_utt` la notebook se detiene (sin ellas no se puede emparejar); si falta alguna otra, se avisa y se sigue sin esa información.\n- Por privacidad, los metadatos de etnia y país del hablante **se descartan al cargar** y no se usan en ningún lado. El identificador de hablante solo se conserva aparte para chequear solapamiento entre splits y **no se exporta**.\n- Con `DEBUG_N` se toman las primeras `DEBUG_N` filas.\n\n**Salida esperada:** nombres de splits disponibles, tamaño, columnas reales, columnas esperadas faltantes o extra.","metadata":{}},{"cell_type":"code","source":"SPLITS_AUDIO = [DEV_SPLIT] + ([FINAL_SPLIT] if RUN_TEST else [])\nEXPECTED_SP = [\"id\", \"locale\", \"partition\", \"scenario_str\", \"intent_str\", \"intent_idx\", \"utt\", \"annot_utt\", \"audio\", \"path\",\n               \"speaker_id\", \"speaker_sex\", \"speaker_age\", \"speaker_first_language\", \"is_validated\", \"is_transcript_reported\", \"slot_method\", \"judgments\"]\nSENSITIVE_COLS = [\"speaker_ethnicity_simple\", \"speaker_country_of_birth\", \"speaker_country_of_residence\", \"speaker_nationality\"]\nSPEECH, SPEAKER_IDS = {}, {}\n\nclass SplitMissing(Exception):\n    pass\n\ndef speech_repo(split):\n    return SPEECH_REPO if split == DEV_SPLIT else SPEECH_TEST_REPO\n\ndef load_speech(split):\n    repo = speech_repo(split)\n    try:\n        names = get_dataset_split_names(repo, LANG, token=HF_TOKEN)\n        print(f\"{repo} [{LANG}] splits disponibles: {names}\")\n        if split not in names:\n            raise SplitMissing(f\"El split '{split}' no existe en {repo} ({LANG}): {names}. Ajustar DEV_SPLIT/FINAL_SPLIT en la configuración.\")\n    except SplitMissing:\n        raise\n    except Exception as e:\n        print(f\"(no se pudieron listar los splits de {repo}: {type(e).__name__}; se intenta cargar igual)\")\n    ds = load_hf_dataset(repo, LANG, split, f\"speech/{split}\")\n    if DEBUG_N:\n        ds = ds.select(range(min(DEBUG_N, len(ds))))\n    cols = list(ds.column_names)\n    print(f\"columnas reales de {repo}/{split}: {cols}\")\n    missing_req = [c for c in [\"id\", \"utt\", \"annot_utt\", \"audio\"] if c not in cols]\n    if missing_req:\n        raise RuntimeError(f\"Faltan columnas imprescindibles en {repo}: {missing_req}. El esquema no coincide con el esperado; \"\n                           f\"revisar la lista de columnas reales de arriba y adaptar el código de forma documentada.\")\n    print(\"esperadas que faltan:\", [c for c in EXPECTED_SP if c not in cols] or \"ninguna\")\n    print(\"columnas extra (no esperadas):\", [c for c in cols if c not in EXPECTED_SP + SENSITIVE_COLS] or \"ninguna\")\n    ds = ds.cast_column(\"audio\", Audio(sampling_rate=SAMPLE_RATE))\n    df = ds.remove_columns([\"audio\"]).to_pandas()\n    df[\"id\"] = df[\"id\"].astype(str)\n    df[\"ds_idx\"] = np.arange(len(df))\n    if \"speaker_id\" in df.columns:\n        SPEAKER_IDS[split] = set(df[\"speaker_id\"].astype(str))\n    df = df.drop(columns=[c for c in SENSITIVE_COLS + [\"speaker_id\"] if c in df.columns])\n    SPEECH[split] = {\"ds\": ds, \"df\": df, \"repo\": repo}\n    print(f\"[{split}] filas: {len(df)}\")\n    return df\n\nfor _sp in SPLITS_AUDIO:\n    load_speech(_sp)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-23T21:36:33.502052Z","iopub.execute_input":"2026-11-23T21:36:33.502428Z","iopub.status.idle":"2026-11-23T21:36:48.086514Z","shell.execute_reply.started":"2026-11-23T21:36:33.502369Z","shell.execute_reply":"2026-11-23T21:36:48.085494Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"README.md:   0%|          | 0.00/65.6k [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"6bdced233cbf