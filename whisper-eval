or sp in SPLITS_AUDIO:\n    texts = condition_texts(MATCHED[sp])\n    EVAL[sp] = {m: {c: fn(texts[c]) for c in \"AB\"} for m, fn in PREDICTORS.items()}\n    print(f\"[{sp}] predicciones: {len(MATCHED[sp])} frases x {len(PREDICTORS)} modelos x 2 condiciones\")\n\ndef as_gold(d):\n    return pd.DataFrame({\"intent_id\": d[\"intent_id_ref\"].values, \"scenario_id\": d[\"scenario_id_ref\"].values,\n                         \"pairs_gold\": list(d[\"pairs_gold_ref\"]), \"tags_gold\": list(d[\"tags_gold_ref\"]),\n                         \"parse_ok\": d[\"parse_ok_ref\"].values})\n\ndef subset_pred(pred, sel):\n    return {k: ([v[i] for i in sel] if isinstance(v, list) else v[sel]) for k, v in pred.items() if k in (\"intent_id\", \"scenario_id\", \"conf\", \"pairs\", \"tags\")}\n\nMETRIC_KEYS = [\"intent_accuracy\", \"intent_macro_f1\", \"scenario_accuracy\", \"scenario_macro_f1\",\n               \"pair_precision\", \"pair_recall\", \"pair_f1\", \"pair_f1_type_only\", \"seq_f1\"]\nLOSS_KEYS = METRIC_KEYS[:7]\n\ndef eval_table(sp, mask=None):\n    d = MATCHED[sp]\n    sel = np.arange(len(d)) if mask is None else np.where(np.asarray(mask))[0]\n    gv = as_gold(d.iloc[sel]).reset_index(drop=True)\n    rows = {}\n    for m in PREDICTORS:\n        for c in \"AB\":\n            rows[(m, c)] = full_metrics(subset_pred(EVAL[sp][m][c], sel), gv, with_seqeval=(c == \"A\"))\n    return pd.DataFrame(rows).T.reindex(columns=METRIC_KEYS + [\"seq_n_excluidas\"])\n\ndef loss_table(tab):\n    rows = {m: transcription_loss(tab.loc[(m, \"A\")], tab.loc[(m, \"B\")], LOSS_KEYS) for m in PREDICTORS}\n    return pd.DataFrame(rows).T","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-23T21:39:42.039181Z","iopub.execute_input":"2026-11-23T21:39:42.039726Z","iopub.status.idle":"2026-11-23T21:39:45.926268Z","shell.execute_reply.started":"2026-11-23T21:39:42.039702Z","shell.execute_reply":"2026-11-23T21:39:45.925609Z"}},"outputs":[{"name":"stdout","text":"[validation] predicciones: 2033 frases x 2 modelos x 2 condiciones\n","output_type":"stream"}],"execution_count":48},{"cell_type":"markdown","source":"### 10.2 Tabla principal: {baseline, BERT} x {referencia, Whisper}\n\nUna fila por modelo y condición (**A** = referencia, **B** = Whisper). Columnas:\n\n- **Intención y escenario:** accuracy y macro-F1.\n- **Entidades:** precisión, recall y F1 de pares (tipo, valor), y el F1 \"solo tipo\" (cuánto de la caída viene de errores de valor y no de no detectar la entidad).\n- **seqeval F1:** solo para la condición A (ver sección 3.3), sobre las frases con parseo alineado (`seq_n_excluidas` cuenta las que se dejaron afuera).\n\nCuando se evalúa `validation`, recordar que son números de **desarrollo** (el checkpoint de BERT y los hiperparámetros del baseline se eligieron con dev de MASSIVE).\n\n**Salida esperada:** una tabla por split de audio evaluado, con 4 filas.","metadata":{}},{"cell_type":"code","source":"TABLES = {}\nfor sp in SPLITS_AUDIO:\n    TABLES[sp] = eval_table(sp)\n    print(f\"=== {sp} (n = {len(MATCHED[sp])} frases emparejadas) ===\")\n    display(TABLES[sp].round(4))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-23T21:39:45.927228Z","iopub.execute_input":"2026-11-23T21:39:45.927549Z","iopub.status.idle":"2026-11-23T21:39:46.259835Z","shell.execute_reply.started":"2026-11-23T21:39:45.927497Z","shell.execute_reply":"2026-11-23T21:39:46.259186Z"}},"outputs":[{"name":"stdout","text":"=== validation (n = 2033 frases emparejadas) ===\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"            intent_accuracy  intent_macro_f1  scenario_accuracy  scenario_macro_f1  pair_precision  pair_recall  pair_f1  pair_f1_type_only  seq_f1  seq_n_excluidas\nbaseline A           0.8431           0.8160             0.8938             0.8885          0.7100       0.5886   0.6436             0.7545  0.6436              0.0\n         B           0.8062           0.7645             0.8687             0.