],\n        \"escenario_pred_B\": [scenario_names[i] for i in pb[\"scenario_id\"]], \"intencion_pred_B\": [intent_names[i] for i in pb[\"intent_id\"]],\n        \"entidades_reales\": [pairs_json(p) for p in d[\"pairs_gold_ref\"]],\n        \"entidades_pred_A\": [pairs_json(p) for p in pa[\"pairs\"]], \"entidades_pred_B\": [pairs_json(p) for p in pb[\"pairs\"]],\n        \"confianza_A\": pa[\"conf\"], \"confianza_B\": pb[\"conf\"], \"baja_confianza_A\": pa[\"flag\"], \"baja_confianza_B\": pb[\"flag\"],\n        \"wer\": d[\"wer\"].values, \"texto_referencia\": d[\"utt_ref\"].values, \"texto_whisper\": d[\"whisper_raw\"].values,\n        \"audio_ref\": [f\"{SPEECH[sp]['repo']}|{LANG}|{sp}|{i}\" for i in d[\"id\"]]}))\ndash = pd.concat(parts, ignore_index=True)\nassert not any(\"speaker\" in c.lower() for c in dash.columns), \"el archivo del dashboard no debe tener datos del hablante\"\ndash.to_csv(DASH_CSV, index=False)\ntry:\n    dash.to_parquet(DASH_PARQUET, index=False)\nexcept Exception as e:\n    warnings.warn(f\"No se pudo escribir parquet ({type(e).__name__}: {e}); queda solo el CSV.\")\nprint(f\"filas: {len(dash)} | columnas: {len(dash.columns)}\")\nfor p in [DASH_PARQUET, DASH_CSV]:\n    if os.path.exists(p): print(f\"{p}: {os.path.getsize(p) / 1e6:.2f} MB\")\ndisplay(dash.head(3))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-23T21:39:50.692881Z","iopub.execute_input":"2026-11-23T21:39:50.693236Z","iopub.status.idle":"2026-11-23T21:39:50.810939Z","shell.execute_reply.started":"2026-11-23T21:39:50.693215Z","shell.execute_reply":"2026-11-23T21:39:50.81031Z"}},"outputs":[{"name":"stdout","text":"filas: 2033 | columnas: 20\n/kaggle/working/dashboard_data.parquet: 0.26 MB\n/kaggle/working/dashboard_data.csv: 0.73 MB\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"      id       split modelo  escenario_real            intencion_real escenario_pred_A          intencion_pred_A escenario_pred_B          intencion