nar. La confianza es el **softmax máximo** de la intención.\n\n**Nota sobre la selección por dev:** el *checkpoint* se elige con MASSIVE-dev, y el split `validation` de Speech-MASSIVE puede coincidir con ejemplos de dev (la sección 7 lo verifica). Por eso las métricas sobre `validation` son de **desarrollo** y algo optimistas; la estimación final es la del split `test`, que no interviene en ninguna decisión.\n\n### 6.1 Tokenizador, datasets y argumentos de entrenamiento\n\nSe carga el tokenizador con `do_lower_case=False` (el modelo es *cased*; se fuerza porque algunas versiones del tokenizador de BETO pasan todo a minúsculas por defecto) y se exige un tokenizador **rápido** (necesario para alinear subpalabras con palabras). Las funciones `enc_intent` y `enc_slots` arman los datasets; `make_training_args` adapta los nombres de argumentos a la versión instalada de `transformers` (`eval_strategy` frente a `evaluation_strategy`, `use_cpu` frente a `no_cuda`) y fuerza CPU si `USE_GPU=False`.\n\n**Salida esperada:** el nombre del tokenizador y un recuento de subpalabras por frase de ejemplo.","metadata":{}},{"cell_type":"code","source":"import shutil, inspect\nfrom transformers import (AutoTokenizer, AutoModelForSequenceClassification, AutoModelForTokenClassification,\n                          TrainingArguments, Trainer, DataCollatorWithPadding, DataCollatorForTokenClassification)\n\nbert_tok = AutoTokenizer.from_pretrained(BERT_MODEL, do_lower_case=False)\nassert bert_tok.is_fast, \"Se necesita un tokenizador rápido para alinear subpalabras con palabras (word_ids).\"\nej = train_df[\"utt\"].iloc[0]\nprint(f\"tokenizador: {type(bert_tok).__name__} | ejemplo: {ej!r} -> {bert_tok.tokenize(ej)}\")\n\nclass EncDS(torch.utils.data.Dataset):\n    def __init__(self, items): self.items = items\n    def __len__(self): return len(self.items)\n    def __getitem__(self, i): return self.items[i]\n\ndef enc_intent(texts, labels):\n    enc = bert_tok([str(t) for t in texts], truncation=True, max_length=BERT_MAX_LEN)\n    return EncDS([{\"input_ids\": enc[\"input_ids\"][i], \"attention_mask\": enc[\"attention_mask\"][i], \"labels\": int(labels[i])}\n                  for i in range(len(enc[\"input_ids\"]))])\n\ndef enc_slots(tokens_list, tags_list):\n    keep = [i for i, t in enumerate(tokens_list) if len(t) > 0]\n    enc = bert_tok([list(tokens_list[i]) for i in keep], is_split_into_words=True, truncation=True, max_length=BERT_MAX_LEN)\n    items = []\n    for k, i in enumerate(keep):\n        labs, prev = [], None\n        for w in enc.word_ids(k):\n            labs.append(-100 if (w is None or w == prev) else slot2id[tags_list[i][w]])\n            prev = w\n        items.append({\"input_ids\": enc[\"input_ids\"][k], \"attention_mask\": enc[\"attention_mask\"][k], \"labels\": labs})\n    return EncDS(items)\n\n_TA = inspect.signature(TrainingArguments.__init__).parameters\ndef make_training_args(out_dir, metric):\n    kw = dict(output_dir=out_dir, num_train_epochs=EPOCHS, per_device_train_batch_size=BERT_BATCH,\n              per_device_eval_batch_size=BERT_BATCH * 2, learning_rate=BERT_LR, weight_decay=BERT_WEIGHT_DECAY,\n              save_strategy=\"epoch\", load_best_model_at_end=True, metric_for_best_model=metric, greater_is_better=True,\n              save_total_limit=1, logging_steps=BERT_LOG_STEPS, seed=SEED, fp16=USE_FP16, report_to=\"none\")\n    kw[\"eval_strategy\" if \"eval_strategy\" in _TA else \"evaluation_strategy\"] = \"epoch\"\n    kw[\"warmup_ratio\" if \"warmup_ratio\" in _TA else \"warmup_steps\"] = BERT_WARMUP_RATIO\n    if device == \"cpu\":\n        kw[\"use_cpu\" if \"use_cpu\" in _TA else \"no_cuda\"] = True\n    return TrainingArguments(**kw)\n\ndef compute_metrics_intent(eval_pred):\n    logits, labels = eval_pred\n    return clf_metrics(labels, np.asarray(logits).argmax(-1))\n\ndef compute_metrics_slots(eval_pred):\n    logits, labels = eval_pred\n    pred = np.asarray(logits).argmax(-1)\n    gold, hyp = [], []\n    for p_row, l_row in zip(pred, labels):\n        gold.append([id2slot[int(l)] for l in l_row if l != -100])\n        hyp.append([id2slot[int(p)] for p, l in zip(p_row, l_row) if l != -100])\n    s = seqeval_scores(gold, hyp)\n    return {\"f1\": s[\"seq_f1\"], \"precision\": s[\"seq_precision\"], \"recall\": s[\"seq_recall\"]}","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-23T21:28:04.990022Z","iopub.execute_input":"2026-11-23T21:28:04.990436Z","iopub.status.idle":"2026-11-23T21:28:25.879583Z","shell.execute_reply.started":"2026-11-23T21:28:04.990404Z","shell.execute_reply":"2026-11-23T21:28:25.878632Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"config.json:   0%|          | 0.00/648 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"fa6193aa6d974993b720e101e5d06bde"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer_config.json:   0%|          | 0.00/364 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"21177375c1ef49c1ba9a87d356c70280"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"vocab.txt:   0%|          | 0.00/242k [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"c0c7c92af22041b29ae71f5d5c1829a9"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"tokenizer.json:   0%|          | 0.00/480k [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"e2f968e903b046909c6dd6b90fda307d"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"special_tokens_map.json:   0%|          | 0.00/134 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"8c0e7160094d44c4a23de4fe6802e837"}},"metadata":{}},{"name":"stdout","text":"tokenizador: BertTokenizer | ejemplo: 'despiértame a las nueve de la mañana el viernes' -> ['despi', '##ér', '##tame', 'a', 'las', 'nueve', 'de', 'la', 'mañana', 'el', 'viernes']\n","output_type":"stream"}],"execution_count":37},{"cell_type":"markdown","source":"### 6.2 Entrenamiento (o carga) de los dos modelos\n\n`train_or_load(kind)` entrena el modelo de `\"intent\"` o de `\"slots\"`, o lo carga del disco si ya existe para esta configuración (`CFG_HASH`). Después de entrenar guarda el modelo, el tokenizador y el registro de entrenamiento (`train_log.json`) y borra los *checkpoints* intermedios para ahorrar espacio. Hay un solo entrenamiento por modelo: **no se vuelve a entrenar** con nada de Whisper ni de audio.\n\n**Salida esperada:** barra de progreso del `Trainer` (si entrena), el tiempo que tardó y una línea con la mejor métrica de dev.\n\n**Si falla la carga del modelo preentrenado** con un error sobre `torch.load` y la versión de torch, actualizar `torch` o usar una versión de `transformers` compatible con el entorno de Kaggle.","metadata":{}},{"cell_type":"code","source":"def train_or_load(kind):\n    path = f\"{MODELS_DIR}/bert_{kind}_{CFG_HASH}\"\n    log_path = f\"{path}/train_log.json\"\n    Auto = AutoModelForSequenceClassification if kind == \"intent\" else AutoModelForTokenClassification\n    if os.path.exists(f\"{path}/config.json\") and os.path.exists(log_path):\n        print(f\"[cache] BERT {kind} cargado desde {path}\")\n        with open(log_path) as f:\n            log = json.load(f)\n        return Auto.from_pretrained(path).to(device).eval(), log\n    t0 = time.time()\n    set_seed(SEED)\n    if kind == \"intent\":\n        names = intent_names\n        model = Auto.from_pretrained(BERT_MODEL, num_labels=len(names), id2label=dict(enumerate(names)), label2id={n: i for i, n in enumerate(names)})\n        ds_tr = enc_intent(train_df[\"utt\"], train_df[\"intent_id\"].values)\n        ds_dev = enc_intent(dev_df[\"utt\"], dev_df[\"intent_id\"].values)\n        collator, cm, metric = DataCollatorWithPadding(bert_tok), compute_metrics_intent, \"accuracy\"\n    else:\n        model = Auto.from_pretrained(BERT_MODEL, num_labels=len(slot_labels), id2label=id2slot, label2id=slot2id)\n        ds_tr = enc_slots(list(train_df[\"tokens_gold\"]), list(train_df[\"tags_gold\"]))\n        ds_dev = enc_slots(list(dev_df[\"tokens_gold\"]), list(dev_df[\"tags_gold\"]))\n        collator, cm, metric = DataCollatorForTokenClassification(bert_tok), compute_metrics_slots, \"f1\"\n    print(f\"[{kind}] entrenamiento: {len(ds_tr)} ejemplos | dev: {len(ds_dev)} | épocas: {EPOCHS} | fp16: {USE_FP16}\")\n    tmp = f\"{path}_tmp\"\n    trainer = Trainer(model=model, args=make_training_args(tmp, metric), train_dataset=ds_tr, eval_dataset=ds_dev,\n                      data_collator=collator, compute_metrics=cm)\n    trainer.train()\n    os.makedirs(path, exist_ok=True)\n    trainer.save_model(path)\n    bert_tok.save_pretrained(path)\n    log = [{k: (float(v) if isinstance(v, (int, float, np.floating)) else v) for k, v in e.items()} for e in trainer.state.log_history]\n    with open(log_path, \"w\") as f:\n        json.dump(log, f)\n    shutil.rmtree(tmp, ignore_errors=True)\n    print(f\"[{kind}] listo en {time.time() - t0:.0f} s; mejor checkpoint: {trainer.state.best_model_checkpoint}\")\n    return trainer.model.to(device).eval(), log\n\nbert_int, log_int = train_or_load(\"intent\")\nbert_slot, log_slot = train_or_load(\"slots\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-23T21:28:25.88063Z","iopub.execute_input":"2026-11-23T21:28:25.881194Z","iopub.status.idle":"2026-11-23T21:36:30.560398Z","shell.execute_reply.started":"2026-11-23T21:28:25.881169Z","shell.execute_reply":"2026-11-23T21:36:30.559703Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"pytorch_model.bin: reconstructing file:   0%|          |  0.00B /  440MB            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"3fd964d1d7b